# docker compose 环境变量示例
# ── 认证密钥（生产必须修改） ────────────────────────────────
# 生成方式（≥32 字符强随机）：
#   Linux/macOS: openssl rand -hex 32
#   Windows PowerShell: -join ((48..57)+(97..102) | Get-Random -Count 64 | % {[char]$_})
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# 硬编码管理员 xiaopac 的初始密码（仅首次创建管理员账号时生效；
# 修改后重启不会覆盖已存在账号的密码；建议 ≥8 位含大小写+数字）
ADMIN_PASSWORD=change-me-to-a-strong-password

# ── 可选配置 ───────────────────────────────────────────────
# 网页端口（宿主机映射；默认 8081）
# 改了记得同步防火墙 / 云安全组 / Caddy 反代地址
# WEB_PORT=8081

# pip 镜像源（国内服务器推荐清华源）
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# Piston 运行时下载源镜像代理（服务器连不上 GitHub 时启用）
# PISTON_REPO_URL=https://ghproxy.com/https://github.com/engineer-man/piston/releases/download/pkgs/index

# 跨域白名单（逗号分隔）；留空 = 仅同源（推荐，生产走 nginx 反代无需跨域）
# CORS_ORIGINS=https://code.example.com

# IP 归属地查询开关（注册指纹采集，失败自动降级）
# GEO_LOOKUP_ENABLED=true

# 沙箱追加的系统级组件（apt 包，空格分隔；改后需 docker compose up -d --build term-runner）
# APT_EXTRA_PACKAGES=python3-opencv ffmpeg

# 终端沙箱并发与每人配额
# TERM_MAX_SESSIONS=30
# TERM_SESSIONS_PER_USER=2
